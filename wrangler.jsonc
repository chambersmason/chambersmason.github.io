{
  "name": "masonchambers-desktop",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOG",
        "class_name": "VisitLog"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VisitLog"
      ]
    }
  ]
}
